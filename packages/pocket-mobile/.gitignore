# Generated by `expo prebuild` for local Android debugging — this project
# deliberately stays on Expo's managed workflow (config plugins only, no
# committed native project); EAS Build generates this fresh on its own
# machine too. Never commit it.
/android
/ios

# Machine-specific local Android build environment (JDK/SDK paths for
# this dev machine) — not portable, not a project convention.
.android-env.sh

# Standard native build output/caches, in case any local tooling writes
# here despite the above.
.gradle/
local.properties
*.hprof
